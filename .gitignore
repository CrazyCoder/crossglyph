__pycache__/
*.pyc
.venv/
.pytest_cache/
build/
dist/
# The workspace ships empty apart from the note that says what goes in it. A
# negation cannot reach inside an ignored directory, so the directory itself is
# never ignored, only its contents.
fonts/*
!fonts/README.md
# The commented template, which is documentation rather than settings: it sets
# nothing, and a workspace works without it. Same rule as above, one level
# deeper, so conf/ is unignored and then emptied again -- the configs somebody
# writes in there are theirs and stay out.
!fonts/conf/
fonts/conf/*
!fonts/conf/all.conf
