__pycache__/
*.pyc
.venv/
.pytest_cache/
build/
dist/
# The workspace ships empty apart from the note that says what goes in it. A
# negation cannot reach inside an ignored directory, so the directory itself is
# never ignored, only its contents.
fonts/*
!fonts/README.md
# The commented template, which is documentation rather than settings: it sets
# nothing, and a workspace works without it. Same rule as above, one level
# deeper, so conf/ is unignored and then emptied again -- the configs somebody
# writes in there are theirs and stay out.
!fonts/conf/
fonts/conf/*
!fonts/conf/all.conf

# Written by the update check, at the install root. A checkout's root is the
# repo, so without this it turns up in git status and, worse, in the release:
# a shipped state file would tell a fresh install it had already checked.
.update-state.json

# The same, for a preview started in the background: where it is listening,
# and what it printed while it ran.
.preview-state.json
preview.log
