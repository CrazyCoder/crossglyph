# Settings shared by every family in this workspace.
#
# Copy this to all.conf to use it. CrossGlyph reads all.conf and leaves this
# template unchanged. The preview creates all.conf when you press Save.
#
# Every setting is optional. The commented values below are the defaults.
# Uncomment a line and change its value to set a shared default. A
# <family>.conf beside all.conf overrides it for that family.
#
# This file cannot set name, family, the explicit style keys, or the two
# fallback family keys. Each of those identifies one family or source file.
#
# Every key, and what the tuning ones actually do, is in docs/fonts.md.

# --- where things go -------------------------------------------------------

# out          = cpfonts
# fallback_dir = fallbacks
# dir          = .

# --- what gets built -------------------------------------------------------

# The sizes are what the reader's Font Size setting lists, one entry each.
# A family can carry any number of sizes.
# sizes        = 12 14 16 18

# Sizes 5 to 8 in the preview. They join the family above unless mod_suffix
# is set, when they build <name><mod_suffix>, a second family beside the
# first in the reader's font list.
# sizes_mod    = 13 15 17 19
# mod_suffix   = Large

# Which codepoints each build carries. `ranges` is appended to `intervals`.
# `reading` already contains `default`, `latin-ext`, `symbols` and
# `vietnamese`, so repeating those names does not expand the coverage. `greek`
# and `cyrillic` add polytonic Greek and the Cyrillic Supplement.
# intervals    = reading
# ranges       = (0x2900-0x29FF),(0x2E00-0x2E7F)

# The bundled Noto families fill codepoints the family itself lacks, with a
# pan-CJK face as well when `intervals` names a CJK script. They are opt-in:
# fetch them with `crossglyph fetch-fallbacks`, or from the preview, before
# changing this to `yes`. A face that has not been fetched is skipped rather
# than being an error, so what a build carries is what the folder holds.
# fallbacks    = no
# space_glyphs = yes

# Which families fill those holes, and in what order. `bundled` stands for the
# set above, so this is a way to put a family of your own in front of it:
#
#   fallback_order = NotoSerif, bundled
#
# A name is a family, not a filename, and is looked for in the fallbacks folder
# first and then among your own families. Leave `bundled` out and the list is
# the whole chain, which is how a family is dropped from the set or the set
# itself reordered:
#
#   fallback_order = NotoSansMath, NotoSansSymbols2
#
# The two families selected as fallback 1 and fallback 2 are always in front of
# this order. `fallback_order` is used only while `fallbacks` is `yes`.
# fallback_order =

# --- how the glyphs look ---------------------------------------------------

# gamma is the most useful single control: above 1 darkens.
# gamma          = 1.0
# thresholds     = 4 8 12
# weight         = 0
# slant          = 0
# hinting        = normal
# stem_darkening = no

# grayscale_hinting fits stems on both axes, on a TrueType face under
# `hinting = normal`. mono rasterizes at one bit per pixel, so the built font
# draws in two levels for every anti-aliasing setting. Mono bypasses gamma and
# thresholds.
# grayscale_hinting = no
# mono              = no

# --- how the text is spaced ------------------------------------------------

# line_height    = 1.15
# letter_spacing = 0
# word_spacing   = 0
# kerning        = yes
# ligatures      = yes
# figures        = default
