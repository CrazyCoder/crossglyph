# Settings shared by every family in this workspace.
#
# Copy this to all.conf to use it. This file is the template and is read by
# nothing; all.conf is yours, and the preview writes it when you press Save.
#
# Nothing here is required, and a workspace with no all.conf at all works.
# Each line below is commented out and carries the value the tool already
# uses, so uncommenting one changes nothing until you edit it. A
# <family>.conf beside all.conf overrides these for that family, and states
# only what it does differently.
#
# This file cannot set name, family, or the explicit style and fallback file
# keys: each of those names one specific family or file.
#
# Every key, and what the tuning ones actually do, is in docs/fonts.md.

# --- where things go -------------------------------------------------------

# out          = cpfonts
# fallback_dir = fallbacks
# dir          = .

# --- what gets built -------------------------------------------------------

# The sizes are what the reader's Font Size setting lists, one entry each.
# sizes        = 12 14 16 18
# sizes_mod    = 13 15 17 19
# mod_suffix   = Mod

# Which codepoints each build carries. `ranges` is appended to `intervals`.
# `reading` already contains `default`, `latin-ext`, `symbols` and
# `vietnamese`, so naming those beside it adds nothing. `greek` and `cyrillic`
# do add something: the main blocks are in `reading`, polytonic Greek and the
# Cyrillic Supplement are not.
# intervals    = reading
# ranges       = (0x2900-0x29FF),(0x2E00-0x2E7F)

# The bundled Noto families fill codepoints the family itself lacks, with a
# pan-CJK face as well when `intervals` names a CJK script. They are opt-in:
# fetch them with `crossglyph fetch-fallbacks`, or from the preview, before
# changing this to `yes`. A face that has not been fetched is skipped rather
# than being an error, so what a build carries is what the folder holds.
# fallbacks    = no
# space_glyphs = yes

# Which families fill those holes, and in what order. `bundled` stands for the
# set above, so this is a way to put a family of your own in front of it:
#
#   fallback_order = NotoSerif, bundled
#
# A name is a family, not a filename, and is looked for in the fallbacks folder
# first and then among your own families. Leave `bundled` out and the list is
# the whole chain, which is how a family is dropped from the set or the set
# itself reordered:
#
#   fallback_order = NotoSansMath, NotoSansSymbols2
#
# The two families the preview's fallback 1 and fallback 2 pick are always in
# front of all of this, so a config never has to account for them. The key does
# nothing while `fallbacks` is `no`.
# fallback_order =

# --- how the glyphs look ---------------------------------------------------

# gamma is the most useful single control: above 1 darkens.
# gamma          = 1.0
# thresholds     = 4 8 12
# weight         = 0
# slant          = 0
# hinting        = normal
# stem_darkening = no

# grayscale_hinting fits stems on both axes, on a TrueType face under
# `hinting = normal`. mono rasterizes at one bit per pixel, which is a build
# that draws in two levels whatever the reader's anti-aliasing is set to, and
# leaves gamma and thresholds nothing to act on.
# grayscale_hinting = no
# mono              = no

# --- how the text is spaced ------------------------------------------------

# line_height    = 1.15
# letter_spacing = 0
# word_spacing   = 0
# kerning        = yes
# ligatures      = yes
# figures        = default
